# Copy to .env and fill in what you need. .env is git-ignored; this file is not.
# `make probe` hands .env to the container with --env-file, and an exported
# variable of the same name wins over the file.

# Metered. Read only by `mm probe --ranker jev`; the mock and laya rankers
# need no credentials.
TYPESAFE_API_KEY=

# Paid, and refused by default: `mm caption` takes it only with --allow-paid
# and --paid-budget-usd above 0. The Claude Code subscription token is the
# route that spends no money, and make mounts it for you.
ANTHROPIC_API_KEY=
